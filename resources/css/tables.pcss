@media (max-width: 767.98px) {
  .table-adaptive:not(.table-scroll *),
  .table-adaptive:not(.table-scroll *) :is(thead, tbody, tfoot, tr, td, th) {
    display: block;
  }

  .table-adaptive:not(.table-scroll *) tr {
    padding: .5rem 0;
  }

  .table-adaptive:not(.table-scroll *) :is(td, th) {
    text-align: center;
  }

  .table-adaptive:not(.table-scroll *) :is(td, th):empty {
    display: none;
  }
}

.table-stats {
  border-collapse: collapse;
  border: 1px solid var(--table-border-color);
}

.table-stats tr + tr {
  border-top: 1px solid var(--table-border-color);
}

.table-stats td,
.table-stats th {
  padding: .35rem .5rem;
  vertical-align: middle;
}

.table-stats tbody tr:nth-child(2n) {
  background-color: var(--table-even-bg-color);
}

.table-stats thead,
.table-stats tfoot,
.table-stats .thead {
  background: var(--table-header-bg);
}

.table-stats thead {
  border-bottom: 1px solid var(--table-border-color);
  font-weight: bold;
}

@media (min-width: theme(--breakpoint-md)) {
  .table-stats thead {
    border-bottom: none;
  }

  .table-stats thead th {
    position: sticky;
    top: -1px;
    z-index: 1;
    background: var(--table-header-bg);
  }

  .table-stats thead th:after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    border-bottom: 1px solid var(--table-border-color);
  }
}

.table-stats tfoot {
  border-top: 1px solid var(--table-border-color);
}

.table-stats-align-top td,
.table-stats-align-top th {
  vertical-align: top;
}
